pipeline {
    agent any
    stages {
        // 1. Setup and preparation
        stage('Install Dependencies') {
            steps { sh 'npm install' }
        }
        
        // 2. Static code analysis (runs even if tests might fail)
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '$SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=amazon-prime -Dsonar.projectKey=amazon-prime'
                }
            }
        }
        
        // 3. Build artifacts
        stage('Build Docker Image') {
            steps { sh 'docker build -t amazon-prime .' }
        }
        
        // 4. Testing (moved after build)
        stage('Unit & Integration Tests') {
            steps {
                script {
                    sh '''
                        # Cleanup any existing processes
                        pkill -f "node.*5000" || true
                        kill $(lsof -t -i:5000) || true
                        sleep 2
                    '''
                    sh 'npm test'
                }
            }
        }
        
        // 5. Deployment stages (only run if all previous succeeded)
        stage('Deploy to Nexus') {
            steps { 
                script {
                    docker.withRegistry("http://${registry}", registryCredentials) {
                        sh 'docker push ${registry}/nodemongoapp:6.0'
                    }
                }
            }
        }
        
        stage('Run Application') {
            steps {
                script {
                    docker.withRegistry("http://${registry}", registryCredentials) {
                        sh '''
                            docker pull ${registry}/nodemongoapp:6.0
                            docker-compose down || true
                            docker-compose up -d
                        '''
                    }
                }
            }
        }
    }
}