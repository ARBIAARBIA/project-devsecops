pipeline {
    agent any

    environment {
        registryCredentials = "nexus"
        registry = "192.168.56.10:8083"
        SCANNER_HOME = tool 'sonar-scanner'
        TEST_PORT = "5000" // Make port configurable
    }
   
    stages {
        stage("Install NPM Dependencies") {
            steps {
                sh "npm install"
            }
        }

        stage('Unit Test') {
            steps {
                script {
                    // More robust port cleanup
                    sh '''
                        # Kill any process using the test port
                        (lsof -ti:${TEST_PORT} | xargs kill -9) || true
                        # Verify port is free
                        while netstat -tuln | grep ":${TEST_PORT}"; do
                            echo "Port ${TEST_PORT} still in use, waiting..."
                            sleep 1
                        done
                    '''
                    sh 'npm test'
                }
            }
            post {
                always {
                    // Cleanup after tests
                    sh '(lsof -ti:${TEST_PORT} | xargs kill -9) || true'
                }
            }
        }

        stage("Sonarqube Analysis") {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=amazon-prime \
                    -Dsonar.projectKey=amazon-prime '''
                }
            }
        }

        stage("Build Docker Image") {
            steps {
                sh "docker build -t ${registry}/nodemongoapp:6.0 ."
            }
        }

        stage('Deploy to Nexus') {
            steps {  
                script {
                    docker.withRegistry("http://${registry}", registryCredentials) {
                        sh 'docker push ${registry}/nodemongoapp:6.0'
                    }
                }
            }
        }

        stage('Run application') {
            steps {  
                script {
                    docker.withRegistry("http://${registry}", registryCredentials) {
                        sh '''
                            docker pull ${registry}/nodemongoapp:6.0
                            docker-compose down || true  # Clean up any existing containers
                            docker-compose up -d
                        '''
                    }
                }
            }
        }
    }
}